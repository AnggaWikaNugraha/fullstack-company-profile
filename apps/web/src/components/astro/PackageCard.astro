---
import type { Package } from '@service/shared';
import { ArrowUpRight, Clock } from '@lucide/astro';
import { formatIDR, packageTypeLabel, shortestDurationWeeks } from '../../utils/format';

interface Props {
  pkg: Package;
}

const { pkg } = Astro.props;
const weeks = shortestDurationWeeks(pkg);
---

<article
  class="group relative flex flex-col rounded-2xl border border-line bg-surface p-6 transition-colors duration-200 hover:border-line-strong hover:bg-raised"
>
  <div class="flex items-start justify-between gap-4">
    <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted">{packageTypeLabel[pkg.type]}</p>
    <ArrowUpRight size={18} class="text-muted transition-colors duration-200 group-hover:text-ink" />
  </div>

  <h3 class="mt-4 text-xl font-medium tracking-tight">
    <a href={`/packages/${pkg.slug}`} class="focus-ring rounded after:absolute after:inset-0 after:rounded-2xl">
      {pkg.name}
    </a>
  </h3>
  <p class="mt-2 leading-relaxed text-muted">{pkg.description}</p>

  <div class="mt-auto pt-8">
    <div class="border-t border-line pt-5">
      <p class="text-sm text-muted">Mulai dari</p>
      <p class="mt-1 text-2xl font-medium tracking-tight">{formatIDR(pkg.starting_price)}</p>
      <p class="mt-3 flex items-center gap-1.5 text-sm text-muted">
        <Clock size={14} />
        Pengerjaan dari {weeks} minggu · {pkg.tiers.length} pilihan tier
      </p>
    </div>
  </div>
</article>

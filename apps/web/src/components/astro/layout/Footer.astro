---
import type { SiteSetting } from '@service/shared';
import { PORTFOLIO_URL } from '../../../utils/navigation';

interface Props {
  site: SiteSetting;
}

const { site } = Astro.props;
const { email, whatsapp } = site.contact;

const columns = [
  {
    title: 'Layanan',
    links: [
      { href: '/packages', label: 'Paket layanan' },
      { href: '/consultation', label: 'Konsultasi' },
      { href: '/products', label: 'Produk digital' },
    ],
  },
  {
    title: 'Konten',
    links: [
      { href: '/portfolio', label: 'Portfolio' },
      { href: '/blog', label: 'Blog' },
      { href: '/events', label: 'Event' },
      { href: '/guide', label: 'Panduan klien' },
    ],
  },
];

const linkClass = 'focus-ring rounded text-sm text-muted transition-colors duration-200 hover:text-ink';
---

<footer class="mt-12 border-t border-line">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
    <div class="col-span-2 max-w-xs md:col-span-1">
      <p class="font-medium">{site.site_name}</p>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        Jasa pembuatan website untuk UMKM dan perusahaan: cepat, rapi, dan mudah dikelola sendiri.
      </p>
    </div>

    {
      columns.map((column) => (
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted">{column.title}</p>
          <ul class="mt-4 grid gap-3">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class={linkClass}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div>
      <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted">Kontak</p>
      <ul class="mt-4 grid gap-3">
        {
          email && (
            <li>
              <a href={`mailto:${email}`} class={linkClass}>
                {email}
              </a>
            </li>
          )
        }
        {
          whatsapp && (
            <li>
              <a href={`https://wa.me/${whatsapp}`} class={linkClass}>
                WhatsApp
              </a>
            </li>
          )
        }
        {
          site.social_links.map((social) => (
            <li>
              <a href={social.url} class={linkClass}>
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-sm text-muted sm:flex-row sm:justify-between sm:px-6">
      <p>&copy; {new Date().getFullYear()} {site.site_name}</p>
      <p>
        Dibuat oleh <a href={PORTFOLIO_URL} class="focus-ring rounded text-ink-soft transition-colors duration-200 hover:text-ink">Angga Wika Nugraha</a>
      </p>
    </div>
  </div>
</footer>

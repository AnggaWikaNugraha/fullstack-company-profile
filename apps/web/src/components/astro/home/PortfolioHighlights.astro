---
import type { PortfolioProject } from '@service/shared';
import { ArrowRight } from '@lucide/astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';

interface Props {
  projects: PortfolioProject[];
}

const { projects } = Astro.props;
---

<section aria-labelledby="portfolio-title" class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-20">
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <SectionHeading
      id="portfolio-title"
      eyebrow="Portfolio"
      title="Hasil kerja untuk klien"
      description="Setiap proyek dimulai dari masalah bisnis yang jelas, bukan sekadar tampilan."
    />
    <Button href="/portfolio" variant="ghost" class="self-start md:self-auto">
      Semua proyek <ArrowRight size={16} />
    </Button>
  </div>

  <div class="mt-12 grid gap-4 md:grid-cols-3">
    {
      projects.map((project) => (
        <article class="group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-surface transition-colors duration-200 hover:border-line-strong">
          {/* Placeholder preview until project galleries come from Cloudinary */}
          <div aria-hidden="true" class="border-b border-line bg-raised/60 p-4">
            <div class="flex gap-1.5">
              <span class="size-2.5 rounded-full bg-white/15" />
              <span class="size-2.5 rounded-full bg-white/15" />
              <span class="size-2.5 rounded-full bg-white/15" />
            </div>
            <div class="mt-6 grid h-24 place-items-center rounded-lg border border-line bg-canvas/60 font-mono text-xs text-muted">
              {project.slug}
            </div>
          </div>

          <div class="flex flex-1 flex-col p-6">
            <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted">{project.client_name}</p>
            <h3 class="mt-3 text-lg font-medium tracking-tight">
              <a href={`/portfolio/${project.slug}`} class="focus-ring rounded after:absolute after:inset-0 after:rounded-2xl">
                {project.title}
              </a>
            </h3>
            <p class="mt-2 leading-relaxed text-muted">{project.summary}</p>
            <ul class="mt-auto flex flex-wrap gap-2 pt-6">
              {project.tech_stack.map((tech) => (
                <li class="rounded-full border border-line px-2.5 py-1 font-mono text-xs text-muted">{tech}</li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>

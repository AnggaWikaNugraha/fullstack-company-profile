---
import { ArrowRight } from '@lucide/astro';
import Button from '../ui/Button.astro';

interface Link {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  primary: Link;
  secondary?: Link;
}

const { title, description, primary, secondary } = Astro.props;
---

<section aria-labelledby="cta-title" class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-20">
  <div class="rounded-3xl border border-line bg-surface px-6 py-12 sm:px-12 sm:py-16">
    <h2 id="cta-title" class="max-w-2xl text-3xl font-medium tracking-tight text-balance sm:text-4xl">{title}</h2>
    <p class="mt-4 max-w-xl leading-relaxed text-muted">{description}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={primary.href}>
        {primary.label}
        <ArrowRight size={16} />
      </Button>
      {secondary && <Button href={secondary.href} variant="secondary">{secondary.label}</Button>}
    </div>
  </div>
</section>

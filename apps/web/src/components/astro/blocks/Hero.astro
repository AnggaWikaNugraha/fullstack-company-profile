---
import { ArrowRight } from '@lucide/astro';
import Button from '../ui/Button.astro';

interface Link {
  href: string;
  label: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  primary: Link;
  secondary?: Link;
  highlights?: string[];
}

const { eyebrow, title, subtitle, primary, secondary, highlights = [] } = Astro.props;
---

<section aria-labelledby="hero-title" class="relative isolate overflow-hidden">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 [background-size:48px_48px] bg-[linear-gradient(to_right,var(--color-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-line)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"
  >
  </div>

  <div class="mx-auto max-w-6xl px-4 pt-12 pb-12 sm:px-6 sm:pt-24 sm:pb-20">
    {eyebrow && <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted">{eyebrow}</p>}
    <h1 id="hero-title" class="mt-4 max-w-4xl text-4xl font-medium tracking-tight text-balance sm:text-5xl lg:text-6xl">
      {title}
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{subtitle}</p>

    <div class="mt-10 flex flex-wrap gap-3">
      <Button href={primary.href}>
        {primary.label}
        <ArrowRight size={16} />
      </Button>
      {secondary && <Button href={secondary.href} variant="secondary">{secondary.label}</Button>}
    </div>

    {
      highlights.length > 0 && (
        <ul class="mt-14 flex flex-wrap gap-2">
          {highlights.map((item) => (
            <li class="rounded-full border border-line px-3 py-1.5 font-mono text-xs text-muted">{item}</li>
          ))}
        </ul>
      )
    }
  </div>
</section>

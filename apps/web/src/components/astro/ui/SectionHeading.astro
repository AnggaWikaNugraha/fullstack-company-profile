---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description?: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<div class="max-w-2xl">
  <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted">{eyebrow}</p>
  <h2 id={id} class="mt-3 text-3xl font-medium tracking-tight text-balance sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 leading-relaxed text-muted">{description}</p>}
</div>
